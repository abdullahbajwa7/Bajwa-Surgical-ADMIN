{
  "version": 2,
  "routes": [
    { "src": "/$", "dest": "/admin/login.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin/login\\.html", "dest": "/admin/login.html" },
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/(images/.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/products\\.json", "headers": { "Cache-Control": "no-cache" } }
  ]
}
